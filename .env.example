# ── Fixion Environment Configuration ──────────────────────────────────────────

# Required: Google Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (for private repos + PR creation)
# Scopes needed: repo, read:org
GITHUB_TOKEN=your_github_pat_here

# ── Agent Configuration ────────────────────────────────────────────────────────

# Gemini model for the agent reasoning loop
FIXION_MODEL=gemini-3.8-flash

# Gemini model for embeddings
FIXION_EMBED_MODEL=gemini-embedding-2

# ── Backend Selection (FREE alternatives to Gemini) ────────────────────────────
# Options: "gemini" | "groq" | "openrouter"
# Switch to "groq" or "openrouter" for free, stronger reasoning models.
FIXION_BACKEND=gemini

# Groq API key (free at https://console.groq.com)
# Recommended model: llama-3.3-70b-versatile or deepseek-r1-distill-llama-70b
# When using groq, set FIXION_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API key (free models at https://openrouter.ai)
# Recommended model: deepseek/deepseek-r1 (free, best reasoning)
# When using openrouter, set FIXION_MODEL=deepseek/deepseek-r1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Max retry attempts in the patch-fix-test loop (per issue)
FIXION_MAX_RETRIES=5

# ── Sandbox Configuration ──────────────────────────────────────────────────────

# Docker image to use as the sandbox base (built from sandbox/Dockerfile.base)
FIXION_SANDBOX_IMAGE=fixion-sandbox:latest

# Per-run timeout in seconds for test execution inside the sandbox
FIXION_SANDBOX_TIMEOUT=300

# Max memory for sandbox containers (Docker memory limit string)
FIXION_SANDBOX_MEMORY=2g

# ── Storage ────────────────────────────────────────────────────────────────────

# Directory where LanceDB indexes are stored per repo
FIXION_INDEX_DIR=.fixion_cache/indexes

# Directory for cloned repo workspaces
FIXION_WORKSPACE_DIR=.fixion_cache/workspaces
